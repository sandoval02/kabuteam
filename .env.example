# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Connect → Framework → Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Supabase → Project Settings → API Keys → Secret key (sb_secret_...).
# Bypasses RLS; used only in trusted server code (e.g. issuing vouchers). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Database password. Used only by the Supabase CLI (link / db push), never by the app.
SUPABASE_DB_PASSWORD=
# Supabase → Connect → Direct → Session pooler → URI. Used only by `npm run db:migrate`.
SUPABASE_DB_URL=

# AI fallback chain (see ARCHITECTURE.md → AI extraction). Server-only.
# Google AI Studio → Get API key (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Comma-separated, tried in order. Copy current Flash and Flash-Lite model IDs from the AI Studio model list.
GEMINI_MODELS=
# Optional last AI step before manual entry. Leave empty to skip. console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Accounts created with these emails become barangay admins (comma-separated).
ADMIN_EMAILS=
